# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./umlforge.db

# ─── JWT / Session ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=your_jwt_secret_key_here

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REMEMBER_DAYS=30

# ─── AI Provider ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=


AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
